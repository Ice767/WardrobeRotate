{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "cargoa",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get index.html, so React Router handles deep links like /track/FM-...
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; everything else is a static file.
    "run_worker_first": ["/api/*"]
  },
  // API_ORIGIN and PROXY_SECRET are Worker secrets; keep them on every deploy.
  "keep_vars": true,
  // Keeps the Render backend awake; see scheduled() in worker.js.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  // Matches the dashboard so a deploy does not switch logging off.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
