{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "wardroberotate",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get index.html, so React Router handles deep links like /track/FM-...
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; everything else is a static file.
    "run_worker_first": ["/api/*"]
  },
  // API_ORIGIN and PROXY_SECRET live in the dashboard; keep them on every deploy.
  "keep_vars": true
}
