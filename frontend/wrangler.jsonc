{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "cargoa",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get index.html, so React Router handles deep links like /track/FM-...
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; everything else is a static file.
    "run_worker_first": ["/api/*"]
  },
  // The backend address is public, so it lives here. PROXY_SECRET is set with
  // `npx wrangler secret put PROXY_SECRET`; keep_vars keeps it on every deploy.
  "vars": {
    "API_ORIGIN": "https://freight-api-7dby.onrender.com"
  },
  "keep_vars": true,
  // Matches the dashboard so a deploy does not switch logging off.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
